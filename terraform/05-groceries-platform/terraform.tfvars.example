# Copy to terraform.tfvars and fill in.
# registry_host is not set here -- it's read automatically from
# 01-infrastructure's state (see remote_state.tf).

web_image_tag = "latest"

# From check-scanner's user-secrets (AzureFoundry:Endpoint / AzureFoundry:ApiKey).
azure_foundry_endpoint = "https://<your-project>.services.ai.azure.com/"
azure_foundry_api_key  = "<your-api-key>"
