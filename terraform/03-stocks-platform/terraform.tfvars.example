# Copy to terraform.tfvars and fill in.
# registry_host is not set here -- it's read automatically from
# 01-infrastructure's state (see remote_state.tf).

pipeline_image_tag = "latest"
web_image_tag      = "latest"

# Azure AI Foundry project + gpt-4o-mini deployment used for flagged-ticker
# commentary. Must be provisioned before the pipeline can call it.
foundry_endpoint = "https://<your-foundry-resource>.openai.azure.com"
foundry_api_key  = "your-foundry-api-key"
